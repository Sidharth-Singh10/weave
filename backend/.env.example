# Weave API configuration
# Copy to .env and fill in values. Never commit .env.
#
# ---------------------------------------------------------------
# LLM provider (opencode-go, OpenAI-compatible protocol)
# ---------------------------------------------------------------
# Base URL of the opencode-go endpoint. Leave the default unless you have a
# custom gateway.
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
#
# API key for the opencode-go provider. Required to enable LLM extraction.
# When unset, the backend runs in deterministic "mock" mode.
# OPENCODE_API_KEY=
#
# Model used for extraction / organization.
# OPENCODE_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------
# Durable state (required)
# ---------------------------------------------------------------
# PostgreSQL connection string. The application refuses to start without it.
DATABASE_URL=postgres://weave:weave@localhost:5432/weave
#
# Redis connection string (hot-path counters: rate limits, quotas, concurrency).
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------
# Google OAuth (Authorization Code flow)
# ---------------------------------------------------------------
# OAuth client credentials from the Google Cloud Console.
# When unset, /auth/google returns a clear configuration error.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Frontend origin, used for redirects after login and the default CORS origin.
FRONTEND_URL=http://localhost:3000
# Additional CORS origins, comma-separated (e.g. a custom domain in prod).
# CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------
SESSION_COOKIE_NAME=weave_session
SESSION_TTL_SECONDS=2592000

# Comma-separated emails granted the admin role on first login, before any
# admin exists. After bootstrap, admin privileges come from the database.
BOOTSTRAP_ADMIN_EMAILS=

# DEV/TEST ONLY: enables POST /auth/test/login which creates a real session for
# an arbitrary email. Never enable in production.
AUTH_STUB=false

# ---------------------------------------------------------------
# Rate limits & quotas
# ---------------------------------------------------------------
# Global defaults, used when no policy row resolves.
RATE_LIMIT_DEFAULT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_DEFAULT_TOKENS_PER_DAY=500000
#
# Absolute safety ceiling; effective limits are min(configured, ceiling).
HARD_CEILING_REQUESTS_PER_MINUTE=300
HARD_CEILING_TOKENS_PER_DAY=20000000
#
# Login-abuse throttles (short-lived, per IP).
OAUTH_INIT_LIMIT_PER_10_MIN=20
OAUTH_CALLBACK_LIMIT_PER_10_MIN=10

# ---------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------
# Maximum accepted request body size in bytes (2 MiB default).
MAX_BODY_BYTES=2097152

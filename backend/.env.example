# Weave API - LLM configuration (opencode-go provider, standalone)
# Copy to .env and fill in your key. Never commit .env.
#
# Provider: opencode-go (OpenAI-compatible protocol).
# Base URL of the opencode-go endpoint. Leave the default unless you have a
# custom gateway.
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
#
# API key for the opencode-go provider. Required to enable LLM extraction.
# When unset, the backend runs in deterministic "mock" mode.
OPENCODE_API_KEY=
#
# Model used for extraction / organization. Fast default:
OPENCODE_MODEL=deepseek-v4-flash

# weave-mcp configuration
# Copy to .env (in this directory) or export in the environment. Never commit .env.

# PostgreSQL URL for the weave_mcp database. The database is created
# automatically on first run if it does not exist.
# WEAVE_MCP_DATABASE_URL=postgres://weave:weave@localhost:5432/weave_mcp

# Directory where stored file blobs (documents, images, audio, ...) live.
# WEAVE_MCP_DATA_DIR=./data

# ---------------------------------------------------------------
# LLM provider (opencode-go, OpenAI-compatible protocol) — shared with weave-api
# ---------------------------------------------------------------
# When OPENCODE_API_KEY is unset, extraction and summarization fall back to a
# deterministic mock (useful for tests/offline).
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_API_KEY=
# OPENCODE_MODEL=deepseek-v4-flash
